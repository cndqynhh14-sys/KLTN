{
  "name": "qlcl",
  "version": "0.1.0",
  "description": "WCM QLCL evaluation-ticket workflow and reporting application",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "test:observability": "node --test test/observability.test.js",
    "test:evidence": "node --test test/evidenceProtocol.test.js",
    "test:migrations": "node --test test/migrations.test.js test/migrations-runner.test.js",
    "test:authorization": "node --test test/authorization.test.js",
    "test:policy": "node --test test/authorization.test.js test/policyStaticGate.test.js",
    "test:audit": "node --test test/auditEvents.test.js",
    "policy:inventory": "node scripts/policy-inventory.js --output artifacts/baseline/run06-policy-inventory.json",
    "navigation:docs": "node scripts/generate-menu-action-matrix.js",
    "action:docs": "node scripts/generate-action-registry-doc.js",
    "test:webapp": "node scripts/run-uat.js local --scenario smoke",
    "test:uat-harness": "node --test test/uatHarness.test.js",
    "uat:smoke": "node scripts/run-uat.js local --scenario smoke",
    "uat:full": "node scripts/run-uat.js local --scenario full",
    "uat:prompt124": "node scripts/run-uat.js local --scenario prompt124",
    "uat:local": "node scripts/run-uat.js local --scenario smoke",
    "uat:staging": "node scripts/run-uat.js staging --scenario smoke",
    "uat:production-readonly": "node scripts/run-uat.js production-readonly --scenario smoke",
    "uat:report": "node scripts/uat-report.js",
    "uat:verify-evidence": "node scripts/verify-uat-evidence.js",
    "migrations:status": "node scripts/migrations.js status",
    "migrations:dry-run": "node scripts/migrations.js dry-run",
    "question-seed:verify": "node scripts/verify-question-seed.js",
    "question-import-template:generate": "node scripts/generate-question-import-workbook.js",
    "personnel-import-workbooks:generate": "node scripts/generate-personnel-import-workbooks.js",
    "report-artifacts:reconcile": "node scripts/report-artifact-reconcile.js",
    "report-export:worker": "node scripts/report-export-worker.js --once",
    "scoring-policy:reconcile": "node scripts/reconcile-scoring-policy.js",
    "stage4:parity": "node scripts/check-stage4-parity.js",
    "evidence:baseline": "node scripts/run-with-evidence.js baseline",
    "evidence:run": "node scripts/run-with-evidence.js run",
    "evidence:test": "node scripts/run-with-evidence.js test",
    "evidence:verify": "node scripts/run-with-evidence.js verify",
    "evidence:bundle": "node scripts/run-with-evidence.js bundle",
    "lint": "node scripts/lint-js.js",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:a11y": "node --test --test-name-pattern \"RUN-23 a11y\" test/releaseQuality.test.js",
    "test:security": "node --test test/policyStaticGate.test.js test/temporaryScreenOtp.test.js test/excelParserValidation.test.js test/questionImportBatches.test.js test/reportArtifacts.test.js test/reportEngine.test.js test/observability.test.js test/uatHarness.test.js test/releaseQuality.test.js",
    "test:nfr": "node scripts/run-nfr-benchmarks.js",
    "release:prepare": "node scripts/prepare-release.js",
    "release:verify": "node scripts/verify-release.js",
    "release:gate": "node scripts/run-release-gate.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --minify"
  },
  "engines": {
    "node": "20.x"
  },
  "files": [
    "server/",
    "public/",
    "src/",
    "migrations/",
    "database/",
    "config/",
    "Template/",
    "scripts/",
    "deploy/",
    "docs/",
    "Dockerfile",
    "railway.json",
    ".dockerignore",
    "tailwind.config.js",
    "CONTEXT.md"
  ],
  "dependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "playwright": "^1.60.0",
    "redis": "^4.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "tailwindcss": "^3.4.19"
  }
}
