# QLCL mini-app — add inside the existing server{} for risk.masangrouptech.com.
# Place BEFORE the SPA fallback `location /` (which serves masan-rms frontend),
# and after `location /cht` to keep path-prefix routing deterministic.

location /qlcl {
    proxy_pass http://127.0.0.1:3005;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_buffering off;

    # xlsx upload can be >1MB — raise default 1MB limit so 413 doesn't bite.
    client_max_body_size 15m;
}
