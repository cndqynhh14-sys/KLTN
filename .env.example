NODE_ENV=development
APP_ENV=development
SERVICE_NAME=qlcl
APP_VERSION=0.1.0
COMMIT_SHA=unknown
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3005
DATA_DIR=./data
DB_PATH=./data/qlcl.db

JWT_SECRET=change-me
JWT_AUDIENCE=qlcl-app
JWT_TTL_SECONDS=28800

ADMIN_EMAILS=admin@example.com
CMC_EMAILS=cmc@example.com

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_MAX=5
OTP_REQUEST_WINDOW_MS=900000
OTP_DELIVERY_MODE=email
OTP_HMAC_SECRET=replace-with-a-distinct-random-secret-at-least-32-bytes
USE_IN_MEMORY_OTP=true
SCREEN_OTP_ENABLED=false
SCREEN_OTP_EXPIRES_AT=
SCREEN_OTP_OWNER=
SCREEN_OTP_ALLOWED_EMAILS=
SCREEN_OTP_PRODUCTION_ACK=

EMAIL_PROVIDER=smtp
EMAIL_MODE=console
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your.email@example.com
SMTP_PASS=replace-with-secret
SMTP_FROM=your.email@example.com
SMTP_FROM_NAME=QLCL

REDIS_URL=redis://127.0.0.1:6379
MAX_UPLOAD_MB=10
MAINTENANCE_RESTORE_TOKEN=
MAINTENANCE_MAX_DB_MB=64
AUDIT_EXPORT_MAX_ROWS=10000
AUDIT_EXPORT_MAX_DAYS=31

# Optional Microsoft Graph email mode.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_SENDER=

# Optional Azure Key Vault mode.
USE_AZURE_KEYVAULT=false
KEY_VAULT_NAME=
# RUN-05 compatibility window for tokens issued before session-backed minimal JWTs.
# Keep false by default. Set true only for a time-bounded deployment compatibility window.
AUTHZ_ALLOW_LEGACY_SESSION=false

# RUN-14 publisher decision gate. Keep disabled until the publisher decision is approved.
QUESTION_VERSION_PUBLISH_ENABLED=0
QUESTION_IMPORT_MAX_BYTES=5242880

# RUN-18 report artifact persistence. Production remains OFF while REPORT-001 is pending.
# Exact production acknowledgement after approval: REPORT-001-APPROVED
REPORT_DURABLE_EXPORTS_ENABLED=0
REPORT_STORAGE_MODE=local
REPORT_STORAGE_ROOT=./data/report-artifacts
# Exact acknowledgement for an approved persistent production volume:
REPORT_LOCAL_VOLUME_APPROVAL=
REPORT_OBJECT_STORAGE_ENABLED=0
REPORT_OBJECT_STORAGE_BUCKET=
REPORT_EXPORT_EXECUTION_MODE=inline
# Exact acknowledgement that a separate production worker is deployed:
REPORT_EXPORT_WORKER_ENABLED=
REPORT_EXPORT_MAX_ATTEMPTS=3
REPORT_RETENTION_DAYS=365
REPORT_GENERATOR_ID=
# Keep disabled until an explicit regeneration policy is approved.
REPORT_REGENERATION_ENABLED=0

# RUN-19 scoring policy publish gate. Keep empty until SCORE-001 is approved.
# Exact acknowledgement after approval: SCORE-001:APPROVED
SCORING_POLICY_PUBLISH_ACK=
# Notification-only warning horizon. This does not change evaluation deadlines.
NOTIFICATION_DEADLINE_WARNING_DAYS=3
